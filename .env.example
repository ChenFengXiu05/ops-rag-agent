# ===== LLM API =====
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
# Options: claude, openai
LLM_PROVIDER=claude
LLM_MODEL=claude-opus-4-6

# ===== Embedding =====
# Options: bge, openai
EMBEDDING_PROVIDER=bge
BGE_MODEL_NAME=BAAI/bge-large-zh-v1.5
BGE_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ===== Vector Store =====
# Options: chroma, milvus
VECTOR_STORE=chroma
CHROMA_PERSIST_DIR=./data/chroma
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=ops_knowledge

# ===== Elasticsearch =====
ES_HOST=http://localhost:9200
ES_USERNAME=elastic
ES_PASSWORD=changeme
ES_INDEX_PATTERN=logs-*

# ===== Prometheus =====
PROMETHEUS_URL=http://localhost:9090

# ===== Notification =====
# DingTalk
DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxx
DINGTALK_SECRET=your_dingtalk_secret

# WeChat Work
WECHAT_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx

# ===== LangSmith (Observability) =====
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key
LANGCHAIN_PROJECT=ops-rag-agent

# ===== App =====
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ===== Security =====
# Comma-separated whitelist of allowed shell commands
SHELL_COMMAND_WHITELIST=kubectl,helm,df,free,top,ps,netstat,ss,ping,curl,wget
# Comma-separated dangerous commands that require approval
HIGH_RISK_COMMANDS=delete,restart,scale,rollout,apply,patch

# ===== Approval Webhook =====
APPROVAL_WEBHOOK_URL=http://localhost:8000/api/v1/approval
